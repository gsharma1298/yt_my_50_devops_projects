
# Terraform state files
*.tfstate
*.tfstate.*

# Terraform working directory
.terraform/

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive files
*.pem
*.key

# CLI configuration
.terraformrc
terraform.rc

# Plan files
*.tfplan
