pipeline {
    agent any

    environment {
        IMAGE_NAME = 'project08'
        SONAR_PROJECT_KEY = 'test'
        SCANNER_HOME = tool 'sonar-scanner'

    }

    stages {

        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/gsharma1298/yt_my_50_devops_projects.git'
            }
        }

        stage('Verify Project Directory') {
            steps {
                dir('project08') {
                    sh 'pwd'
                    sh 'ls -la'
                    sh 'test -f pom.xml'
                }
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                dir('project08') {
                    sh '''
                        trivy fs \
                          --scanners vuln,misconfig,secret \
                          --severity HIGH,CRITICAL \
                          --exit-code 1 \
                          .
                    '''
                }
            }
        }

        stage('Compile and Unit Tests') {
            steps {
                dir('project08') {
                    sh 'mvn clean verify'
                }
            }
        }

        

stage('SonarQube Analysis') {
    steps {
        dir('project08') {
            withSonarQubeEnv('SonarQube') {
                withCredentials([
                    string(
                        credentialsId: 'sonar-token',
                        variable: 'SONAR_TOKEN'
                    )
                ]) {
                    sh '''
                        $SCANNER_HOME/bin/sonar-scanner \
                          -Dsonar.projectKey=test \
                          -Dsonar.projectName=test \
                          -Dsonar.sources=src \
                          -Dsonar.java.binaries=target/classes \
                          -Dsonar.token="$SONAR_TOKEN"
                    '''
                }
            }
        }
    }
}


        stage('Build Docker Image') {
            steps {
                dir('project08') {
                    sh '''
                        docker build \
                          -t ${IMAGE_NAME}:${BUILD_NUMBER} .
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    trivy image \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      ${IMAGE_NAME}:${BUILD_NUMBER}
                '''
            }
        }

        stage('Archive JAR') {
            steps {
                archiveArtifacts(
                    artifacts: 'project08/target/*.jar',
                    fingerprint: true
                )
            }
        }
    }

    post {
        success {
            echo 'Project 08 DevSecOps pipeline passed.'
        }

        failure {
            echo 'Pipeline failed. Review build and security scan logs.'
        }

        always {
            echo 'Project 08 DevSecOps pipeline execution completed.'
        }
    }
}
