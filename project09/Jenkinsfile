pipeline {
    agent any

    stages {
        stage('Git Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/gsharma1298/yt_my_50_devops_projects.git'

                dir('project09') {
                    sh 'ls -la'
                }
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                dir('project09') {
                    sh 'trivy fs --scanners vuln,misconfig,secret .'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('project09') {
                    sh 'docker build -t project9:${BUILD_NUMBER} .'
                }
            }
        }

        stage('push to ecr') {
            steps {
                sh '''
                    aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 253291597598.dkr.ecr.ap-south-1.amazonaws.com
                    docker tag project9:${BUILD_NUMBER} 253291597598.dkr.ecr.ap-south-1.amazonaws.com/ecr:${BUILD_NUMBER}
                    docker push 253291597598.dkr.ecr.ap-south-1.amazonaws.com/ecr:${BUILD_NUMBER}
                '''
            }
        }

        stage('Update Deployment file') {
            environment {
                GIT_REPO_NAME = "yt_my_50_devops_projects"
                GIT_EMAIL = "gsharma1298@gmail.com"
                GIT_USER_NAME = "gsharma1298"
                IMAGE_NAME = "ecr"
                REPO_URL = "253291597598.dkr.ecr.ap-south-1.amazonaws.com/ecr"
                FILE = "userdata.sh"
            }

            steps {
                dir('project09') {
                    withCredentials([string(credentialsId: 'git-tokan', variable: 'git_token')]) {
                        sh '''
                            git config user.email "${GIT_EMAIL}"
                            git config user.name "${GIT_USER_NAME}"
                            BUILD_NUMBER=${BUILD_NUMBER}
                            echo $BUILD_NUMBER

                            # push this image to your git hub
                            sed -i -E "s#(amazonaws\.com/ecr:)[^[:space:]\"']+#\1${BUILD_NUMBER}#" userdata.sh
                            git add .
                            git commit -m "Image to version \${BUILD_NUMBER}"
                            git push https://${git_token}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Project 09 DevSecOps Pipeline SUCCESS!'
        }

        failure {
            echo 'Project 09 DevSecOps Pipeline FAILED!'
            echo 'Check Jenkins Console Output.'
        }

        always {
            echo 'Project 09 pipeline execution completed.'
        }
    }
}
